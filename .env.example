# ==============================================================================
# SolarShield AI Photovoltaic Monitor v2.5 — Environment Configuration Template
# Copy this file to .env and adjust variables for your target deployment environment.
# ==============================================================================

# Server Network Configuration
# Hosting platforms (Render, Railway, etc.) automatically provide the PORT variable.
PORT=3000
HOST=0.0.0.0

# Database Persistence Configuration
# - Ephemeral free tier (default): stores in local solarshield.db in container root.
# - Persistent Volume (e.g. Render Starter Disk mounted at /var/data):
#   Set DATABASE_PATH=/var/data/solarshield.db to preserve all records across deploys.
DATABASE_PATH=solarshield.db

# File Uploads Directory
# - Ephemeral free tier (default): stores in local data/images in container root.
# - Persistent Volume:
#   Set UPLOADS_DIR=/var/data/images to preserve uploaded test frames across deploys.
UPLOADS_DIR=data/images

# Security & Session Secrets
# Replace with a cryptographically secure random key in production
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production

# Default Admin User Credentials (Only used when database is freshly initialized)
ADMIN_DEFAULT_EMAIL=admin@solarshield.com
ADMIN_DEFAULT_PASSWORD=replace-with-secure-admin-password

# Environment Mode
ENVIRONMENT=production
DEBUG=false
